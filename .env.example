# ============================================================
# ARC Platform - Environment Variables Template
# ============================================================
# Copy this file:
#   Development: cp .env.example .env
#   Production:  cp .env.example .env  (then fill in production values)
# ============================================================

# --- Application ---
APP_ENV=development          # development | production
LOG_LEVEL=info               # debug | info | warn | error

# --- Server ---
SERVER_PORT=8080
SERVER_HOST=0.0.0.0

# --- Database (PostgreSQL) ---
POSTGRES_USER=your_db_user
POSTGRES_PASSWORD=your_strong_db_password_here
POSTGRES_DB=your_db_name

DB_HOST=postgres             # container name inside docker network
DB_PORT=5432                 # internal container port
DB_USER=your_db_user         # same as POSTGRES_USER
DB_PASSWORD=your_strong_db_password_here  # same as POSTGRES_PASSWORD
DB_NAME=your_db_name         # same as POSTGRES_DB
DB_SSLMODE=disable           # disable for docker network, require for external

# --- JWT ---
JWT_SECRET=CHANGE_ME_generate_with_openssl_rand_base64_48
JWT_EXPIRATION=24            # hours

# --- MinIO (Object Storage) ---
MINIO_ROOT_USER=your_minio_admin_user
MINIO_ROOT_PASSWORD=your_strong_minio_password_here
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=your_minio_admin_user
MINIO_SECRET_KEY=your_strong_minio_password_here
MINIO_USE_SSL=false
MINIO_BUCKET_NAME=arc-images
MINIO_PUBLIC_URL=http://localhost:9002

# --- Frontend URLs ---
VITE_API_URL=http://localhost:8081/api/v1
NEXT_PUBLIC_API_URL=http://localhost:8081/api/v1

# --- Frontend Ports ---
POS_FRONTEND_PORT=3004
ADMIN_FRONTEND_PORT=3005
SUPER_ADMIN_FRONTEND_PORT=3006
QR_MENU_FRONTEND_PORT=3003
